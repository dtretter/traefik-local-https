# Vorlage fuer .env - kopieren und anpassen:
#   cp .env.example .env && chmod 600 .env
# .env enthaelt Zugangsdaten und wird NICHT eingecheckt (.gitignore).

# Domain fuer lokale Dienste. Alle Subdomains (*.<domain>) werden lokal
# aufgeloest und bekommen ein Wildcard-Zertifikat. Muss eine (Sub-)Domain
# sein, deren DNS-Zone du ueber die API deines DNS-Providers verwalten kannst.
DEV_HTTPS_DOMAIN=dev.example.com

# IPv4-Adresse der Docker-Bridge docker0 auf diesem Host:
#   ip -4 -br addr show docker0
# Standard bei Docker: 172.17.0.1 (abweichend z.B. bei "default-address-pools"
# oder "bip" in /etc/docker/daemon.json).
HOST_GATEWAY_IP=172.17.0.1

# Optional: Upstream-Resolver fuer container-dns (alle Nicht-Dev-Namen).
# Standard: systemd-resolved-Stub. Nur aendern, wenn du weisst warum.
#HOST_DNS_UPSTREAM=127.0.0.53

# Let's Encrypt: Kontaktadresse fuer Ablauf-/Sicherheitshinweise
ACME_EMAIL=admin@example.com

# DNS-Provider fuer die DNS-01-Challenge (Name laut Traefik/lego-Doku):
#   https://doc.traefik.io/traefik/https/acme/#providers
ACME_DNS_PROVIDER=hetzner

# Zugangsdaten des DNS-Providers - Variablennamen haengen vom Provider ab
# (siehe Link oben). Beispiele:
#
# Hetzner (DNS ueber die Hetzner Console / Cloud API):
HETZNER_API_TOKEN=
# Hetzner, aelterer DNS Console-Zugang (alte lego-Versionen):
#HETZNER_API_KEY=
#
# Cloudflare (ACME_DNS_PROVIDER=cloudflare):
#CF_DNS_API_TOKEN=
#
# INWX (ACME_DNS_PROVIDER=inwx):
#INWX_USERNAME=
#INWX_PASSWORD=
